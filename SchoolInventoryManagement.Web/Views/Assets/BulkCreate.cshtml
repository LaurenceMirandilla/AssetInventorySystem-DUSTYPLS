@model SchoolInventoryManagement.Web.ViewModels.AssetBulkCreateViewModel
@using SchoolInventoryManagement.Web.Helpers
@using SchoolInventoryManagement.Web.ViewModels
@{
    ViewData["Title"] = "Bulk Register Assets";
    var modelChoices = (List<SchoolInventoryManagement.Web.ViewModels.ModelCodeOption>)ViewBag.ModelChoices;
    ViewData["SelectedModelId"] = Model.ModelID;
    // Registering the units bought for a new-item request.
    var ticket = ViewBag.Ticket as SchoolInventoryManagement.Web.ViewModels.BulkTicketInfo;
    // Where the units go (no Branch or Location on the form).
    var place = ViewBag.Place as AssetPlace;
    // Bought for a requisition: the items still to register, each with its
    // purchase order price (Scripts/037).
    var openLines = ticket?.Lines.Where(l => l.Left > 0 || l.NewItemRequestItemID == Model.NewItemRequestItemID
        || Model.Extras.Any(x => x.NewItemRequestItemID == l.NewItemRequestItemID)).ToList() ?? new List<BulkTicketLine>();
    var canQuickAdd = ViewBag.QuickAddCategories != null;
    string Price(decimal? p) => p is null ? "" : p.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
}

<div class="asset-detail-head">
    <div>
        <nav class="asset-crumbs" aria-label="Breadcrumb">
            @if (ticket is not null)
            {
                <a asp-controller="NewItemRequests" asp-action="Details" asp-route-id="@ticket.RequestID">Requisition #@ticket.RequestID</a>
            }
            else
            {
                <a asp-action="Index">Assets</a>
            }
            <span aria-hidden="true">&rsaquo;</span>
            <span>Bulk register</span>
        </nav>
        <h2 class="asset-detail-title">Bulk register assets</h2>
        <div class="asset-detail-sub">
            Register many units at once: one model per row, and "+ Add another item" for more models in the same delivery.
            Codes come from each model's category and are numbered for you; everything under "Shared by every unit" applies to all of them.
        </div>
    </div>
    @if (ticket is null)
    {
        <div class="asset-detail-actions">
            <a asp-action="Create" class="btn btn-outline-secondary">Register just one instead</a>
        </div>
    }
</div>

@if (ticket is not null)
{
    <div class="sab-callout mb-3">
        <span class="sab-callout-label">Bought for requisition #@ticket.RequestID · @ticket.DepartmentName</span>
        Item by item, what was bought and what is registered so far. Register what the supplier delivered; if part is still to come, lower the quantity
        and use "Pending: send what arrived" on the requisition. They are held by the Property Department until @ticket.RequesterName confirms receipt; then they are @(ticket.DepartmentName)'s.
        <ul class="mb-0 mt-2">
            @foreach (var line in ticket.Lines)
            {
                <li>@line.ItemName · @line.Registered of @line.Quantity registered@(line.ModelID is null && line.Registered == 0 ? " (pick or add its model)" : "")@(line.EstimatedUnitPrice is decimal p ? $" · ₱{p:N2} each on the purchase order" : "")</li>
            }
        </ul>
    </div>
    <partial name="_BoughtItems" model="((ViewBag.Bought as List<BoughtLine>) ?? new List<BoughtLine>(), (int?)null)" />
}

@{
    // One extra row (Scripts/037). Field names are set when the form is
    // sent (Extras[0].ModelID, ...), so rows can be added and removed.
    async Task ExtraRow(BulkExtraBatch? x)
    {
        <div class="bulk-extra" data-extra>
            @if (ticket is not null)
            {
                <select class="form-select" data-x="NewItemRequestItemID" aria-label="For item">
                    @foreach (var l in openLines)
                    {
                        <option value="@l.NewItemRequestItemID" data-price="@Price(l.EstimatedUnitPrice)" data-name="@l.ItemName"
                                selected="@(x?.NewItemRequestItemID == l.NewItemRequestItemID)">For: @l.ItemName (@l.Left left)</option>
                    }
                </select>
            }
            <select class="form-select" data-x="ModelID" aria-label="Model">
                <option value="">Pick a model…</option>
                @foreach (var m in modelChoices)
                {
                    <option value="@m.ModelID" data-name="@m.ModelName" data-prefix="@m.CodePrefix" selected="@(x?.ModelID == m.ModelID)">@m.Label</option>
                }
            </select>
            <input type="number" class="form-control" data-x="Quantity" min="1" max="200" value="@(x?.Quantity > 0 ? x.Quantity : 1)" aria-label="Quantity" />
            <input type="text" class="form-control" data-x="BaseName" maxlength="130" placeholder="Name (the model's)" value="@x?.BaseName" data-auto="@(string.IsNullOrEmpty(x?.BaseName) ? null : "true")" aria-label="Name" />
            <div class="bulk-extra-actions">
                @if (canQuickAdd)
                {
                    <button type="button" class="btn btn-link btn-sm p-0" data-x-newmodel>+ New model</button>
                }
                <button type="button" class="btn btn-link btn-sm p-0 text-danger" data-x-remove>Remove</button>
            </div>
        </div>
    }
}
<template id="extraTemplate">@{ await ExtraRow(null); }</template>

<form asp-action="BulkCreate" method="post" enctype="multipart/form-data" class="register-form" id="bulkForm">
    @Html.AntiForgeryToken()
    @Html.FormTicket()
    <input type="hidden" asp-for="NewItemRequestID" />
    <input type="hidden" name="returnTo" value="@(ViewBag.ReturnTo as string)" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-lg-8">

            <div class="asset-card register-step mb-3">
                <div class="register-step-head">
                    <span class="register-step-num">1</span>
                    <div>
                        <div class="register-step-title">What and how many</div>
                        <div class="register-step-sub">One model per batch, up to 200 units.</div>
                    </div>
                </div>
                <div class="register-step-body">
                    <div class="row g-3">
                        @if (ticket is not null)
                        {
                            <div class="col-12">
                                <label class="form-label" for="mainLine">For item</label>
                                <select class="form-select" id="mainLine" name="NewItemRequestItemID" data-line>
                                    @foreach (var l in openLines)
                                    {
                                        <option value="@l.NewItemRequestItemID" data-price="@Price(l.EstimatedUnitPrice)" data-name="@l.ItemName" data-left="@l.Left"
                                                selected="@(l.NewItemRequestItemID == Model.NewItemRequestItemID)">@l.ItemName · @l.Left left to register</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="col-md-8">
                            <partial name="_ModelPicker" model="modelChoices" view-data="ViewData" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Quantity" class="form-label">Quantity</label>
                            <div class="qty-stepper">
                                <button type="button" class="qty-btn" data-step="-1" aria-label="One fewer">&minus;</button>
                                <input asp-for="Quantity" id="quantity" type="number" min="1" max="200" class="form-control" />
                                <button type="button" class="qty-btn" data-step="1" aria-label="One more">+</button>
                            </div>
                            <div class="form-text">1 to 200</div>
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            @* More items in the same delivery (Scripts/037): each row is its own
               model and quantity; names follow the model. *@
            <div class="asset-card register-step mb-3" id="extrasCard">
                <div class="register-step-head">
                    <span class="register-step-num">+</span>
                    <div class="flex-grow-1">
                        <div class="register-step-title">@(ticket is not null ? "Other items in this delivery" : "More items")</div>
                        <div class="register-step-sub">Another model? Add it here instead of registering again. Serial numbers for these can be added later from each asset's page.</div>
                    </div>
                </div>
                <div class="register-step-body">
                    <div id="extraRows">
                        @foreach (var x in Model.Extras)
                        {
                            await ExtraRow(x);
                        }
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="addExtra">+ Add another item</button>
                </div>
            </div>

            <div class="asset-card register-step mb-3">
                <div class="register-step-head">
                    <span class="register-step-num">2</span>
                    <div>
                        <div class="register-step-title">Name</div>
                        <div class="register-step-sub">Each unit is named "Name - Unit N", N counting this model's units: its first is Unit 1.</div>
                    </div>
                </div>
                <div class="register-step-body">
                    <label asp-for="BaseName" class="form-label">Base name</label>
                    <input asp-for="BaseName" id="baseName" class="form-control" placeholder="e.g. Monobloc Chair" data-auto="@(ViewBag.AutoName == true ? "true" : null)" />
                    <div class="form-text">The model's name, filled in when you pick it. You can change it.</div>
                    <span asp-validation-for="BaseName" class="text-danger"></span>

                    <div class="bulk-preview mt-3">
                        <div class="bulk-preview-head" id="previewHead">Pick a model and enter a name to see the codes.</div>
                        <div id="previewBody"></div>
                    </div>
                </div>
            </div>

            <div class="asset-card register-step mb-3">
                <div class="register-step-head">
                    <span class="register-step-num">3</span>
                    <div class="flex-grow-1">
                        <div class="register-step-title">Serial numbers <span class="register-optional fw-normal">(optional)</span></div>
                        <div class="register-step-sub">One per line, in the same order as the codes — paste a column straight from a spreadsheet.</div>
                    </div>
                    <span id="serialCount" class="bulk-serial-count d-none"></span>
                </div>
                <div class="register-step-body">
                    @* The codes run down the left so each line visibly belongs
                       to one unit; the gutter scrolls with the box. *@
                    <div class="bulk-serials">
                        <div class="bulk-serials-gutter" id="serialGutter" aria-hidden="true"></div>
                        <textarea asp-for="SerialNumbers" id="serialNumbers" rows="6" spellcheck="false" wrap="off"
                                  aria-label="Serial numbers, one per line"></textarea>
                    </div>
                    <div class="form-text">Lines line up with the codes on the left. Blank ones can be added later from each asset's page.</div>
                </div>
            </div>

        </div>

        <div class="col-lg-4">
            <div class="bulk-summary mb-3">
                <div class="bulk-summary-label">This batch</div>
                <div class="bulk-summary-stats">
                    <div><strong id="sumUnits">0</strong><span>units</span></div>
                    <div><strong id="sumCost" class="is-empty">Not set</strong><span>total cost</span></div>
                    <div><strong id="sumSerials">0</strong><span>serials</span></div>
                </div>
                <div class="bulk-summary-note">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" /><path d="m9 12 2 2 4-4" /></svg>
                    All or nothing — if one unit can't be saved, none are.
                </div>
            </div>

            <div class="asset-card register-step mb-3">
                <div class="register-step-head">
                    <span class="register-step-num">4</span>
                    <div>
                        <div class="register-step-title">Shared by every unit</div>
                        <div class="register-step-sub" id="sharedSub">Set once, applied to all of them.</div>
                    </div>
                </div>
                <div class="register-step-body">
                    @* No Branch or Location to pick (AssetsController.PlaceAssets):
                       bought for a requisition, they go to the Property
                       Department of the requesting department's branch;
                       otherwise to the branch of whoever registers them. They
                       are placed in the department's main room. *@
                    @if (ticket is not null)
                    {
                        var stock = place?.Property;
                        <div class="mb-3">
                            <div class="form-label">Goes to</div>
                            <input type="hidden" asp-for="DepartmentID" />
                            <div class="reg-place" data-room-code="@stock?.RoomCode">
                                <strong>Property Department · @ticket.BranchName</strong>
                                <span>@(stock?.RoomName ?? "No room yet") · held for requisition #@ticket.RequestID</span>
                            </div>
                            <div class="form-text">The branch of the @ticket.DepartmentName, which asked for them. They become the @(ticket.DepartmentName)'s when @ticket.RequesterName confirms receipt.</div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="DepartmentID" class="form-label">Belongs to</label>
                            <select asp-for="DepartmentID" id="departmentSelect" class="form-select">
                                @foreach (var dept in place?.Departments ?? new List<AssetPlaceDepartment>())
                                {
                                    <option value="@dept.DepartmentID" data-property="@(dept.IsProperty ? "true" : null)" data-room="@dept.RoomName" data-room-code="@dept.RoomCode"
                                            selected="@(dept.DepartmentID == Model.DepartmentID)">@(dept.IsProperty ? dept.DepartmentName + " (in stock, can be borrowed)" : dept.DepartmentName)</option>
                                }
                            </select>
                            <span asp-validation-for="DepartmentID" class="text-danger"></span>
                            <div class="reg-place mt-2">
                                <strong>@(place?.BranchName ?? "No branch")</strong>
                                <span>Room: <span id="roomName">—</span></span>
                            </div>
                            <div class="form-text">Your branch. Property Department: in stock and can be borrowed. Any other department: issued to it, and it cannot be borrowed.</div>
                        </div>
                    }

                    <div class="mb-3">
                        <div class="form-label">Condition</div>
                        <partial name="_ConditionChips" model="Model.Condition" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="AcquisitionDate" class="form-label">Acquired on <span class="register-optional">(optional)</span></label>
                            <input asp-for="AcquisitionDate" type="date" class="form-control" />
                        </div>
                        @if (ticket is null)
                        {
                            <div class="col-6">
                                <label asp-for="AcquisitionCost" class="form-label">Cost each <span class="register-optional">(optional)</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">₱</span>
                                    <input asp-for="AcquisitionCost" id="unitCost" type="number" step="0.01" min="0" placeholder="0.00" class="form-control" />
                                </div>
                                <span asp-validation-for="AcquisitionCost" class="text-danger"></span>
                            </div>
                        }
                        else
                        {
                            @* Bought: each unit costs its item's price on the purchase order (Scripts/037). *@
                            <div class="col-6">
                                <div class="form-label">Cost each</div>
                                <div class="reg-place"><strong>From the purchase order</strong><span>each item at its ordered price</span></div>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="WarrantyInformation" class="form-label">Warranty until <span class="register-optional">(optional)</span></label>
                        <input asp-for="WarrantyInformation" type="date" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <div class="form-label">Warranty photo or file <span class="register-optional">(optional)</span></div>
                        <label class="file-drop file-drop-row">
                            <span class="file-drop-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6v18h12V7z" /><path d="M14 3v4h4" /></svg>
                            </span>
                            <span class="flex-grow-1">
                                <span class="file-drop-title" data-empty="Linked to every unit">Linked to every unit</span>
                                <span class="file-drop-sub">Photo or PDF · up to @FileUploads.MaxMegabytes MB</span>
                            </span>
                            <span class="btn btn-outline-secondary btn-sm">Choose</span>
                            <input asp-for="WarrantyFile" type="file" accept="@FileUploads.DocumentAccept"
                                   data-max-bytes="@FileUploads.MaxBytes" class="file-drop-input" />
                        </label>
                    </div>

                    <div>
                        <label asp-for="Description" class="form-label">Description <span class="register-optional">(optional)</span></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Shared notes for the whole batch."></textarea>
                    </div>
                </div>
            </div>

            <div class="asset-card register-toggle">
                <span class="register-toggle-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6v12M7 6v12M11 6v12M14 6v12M18 6v12M20 6v12" /></svg>
                </span>
                <label for="createBarcode" class="flex-grow-1 mb-0">
                    <span class="register-toggle-title" id="barcodeTitle">Barcode labels for every unit</span>
                    <span class="register-toggle-sub">Left off, none are made; you can add one later from each asset's page.</span>
                </label>
                <div class="form-check form-switch m-0">
                    <input asp-for="CreateBarcode" type="checkbox" role="switch" id="createBarcode" class="form-check-input" />
                </div>
            </div>
        </div>
    </div>

    <div class="register-footer">
        <span>Nothing is saved unless every unit can be.</span>
        <div class="d-flex" style="gap:8px;">
            @* For a requisition: back to it, where registering is still the next step. *@
            <a href="@(ticket is not null ? Url.RequisitionBackUrl(ticket.RequestID, ViewBag.ReturnTo as string) : Url.Action("Index"))" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" id="submitBtn" class="btn btn-primary">Register assets</button>
        </div>
    </div>
</form>

@{
    // Bought for a requisition and not in the system yet: "Add a new model"
    // starts with its name (and description), still editable.
    var newLine = ticket?.Lines.FirstOrDefault(l => l.ModelID == null && l.Registered < l.Quantity);
    ViewData["QuickAddName"] = newLine?.ItemName;
    ViewData["QuickAddDescription"] = newLine?.Description;
}
<partial name="_QuickAddModel" view-data="ViewData" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            var quantity = document.getElementById('quantity');
            var baseName = document.getElementById('baseName');
            var serials = document.getElementById('serialNumbers');
            var gutter = document.getElementById('serialGutter');
            var previewHead = document.getElementById('previewHead');
            var previewBody = document.getElementById('previewBody');
            var serialCount = document.getElementById('serialCount');
            var submitBtn = document.getElementById('submitBtn');
            var unitCost = document.getElementById('unitCost');
            var createBarcode = document.getElementById('createBarcode');
            var maxNumber = @SchoolInventoryManagement.BLL.Services.AssetCodes.MaxNumber;
            // The branch they go to, and the room (the department's).
            var branchCode = '@(place?.BranchCode)';
            var departmentSelect = document.getElementById('departmentSelect');
            var fixedPlace = document.querySelector('.reg-place[data-room-code]');

            // The picked model's category code, next free number and next
            // "Unit N", from the model search box.
            var picked = null;
            // A name the page filled in (from the requisition) follows the
            // model picked; one typed by hand stays.
            var autoName = baseName.dataset.auto ? baseName.value : '';

            // Mirrors AssetService: code {category}-{number:D4}, barcode
            // {branch}-{room}-{code}, name "{name} - Unit {n}" (n: the model's own count).
            function pad(n) {
                var s = String(n);
                while (s.length < 4) s = '0' + s;
                return s;
            }

            function codeFor(number) { return picked.prefix + '-' + pad(number); }

            // "M-LIB": the branch, and the room's code (XXX with no room).
            function roomOption() { return departmentSelect ? departmentSelect.options[departmentSelect.selectedIndex] : null; }
            function codeStart() {
                if (!branchCode) return null;
                var roomCode = departmentSelect
                    ? ((roomOption() && roomOption().getAttribute('data-room-code')) || '')
                    : (fixedPlace ? fixedPlace.getAttribute('data-room-code') : '');
                return branchCode + '-' + (roomCode || '@SchoolInventoryManagement.BLL.Services.AssetCodes.NoLocation');
            }
            function showRoom() {
                var room = document.getElementById('roomName');
                if (!room) return;
                var o = roomOption();
                room.textContent = (o && o.getAttribute('data-room')) || 'none yet';
            }

            function escapeHtml(text) {
                var div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            // ₱27.8K, ₱1.2M -- the summary tile is narrow.
            function compactPeso(value) {
                if (value >= 1e6) return '₱' + (value / 1e6).toFixed(1).replace(/\.0$/, '') + 'M';
                if (value >= 1e3) return '₱' + (value / 1e3).toFixed(1).replace(/\.0$/, '') + 'K';
                return '₱' + value.toFixed(2).replace(/\.00$/, '');
            }

            function update() {
                var qty = parseInt(quantity.value, 10) || 0;
                var n = baseName.value.trim();
                var valid = picked && qty >= 1 && qty <= 200 && picked.next + qty - 1 <= maxNumber;

                // Barcodes are only shown when "Add barcode" is on and a
                // branch is picked.
                var start = createBarcode.checked ? codeStart() : null;
                // The i-th unit of this batch: its code, and its unit number for the model.
                function row(i) {
                    var code = codeFor(picked.next + i);
                    return '<div class="bulk-preview-row"><span class="asset-code-chip">' + escapeHtml(code) + '</span>'
                        + '<span>' + escapeHtml(n + ' - Unit ' + (picked.nextUnit + i)) + '</span>'
                        + (start ? '<span class="bulk-preview-barcode">' + escapeHtml(start + '-' + code) + '</span>' : '')
                        + '</div>';
                }

                previewBody.innerHTML = '';
                if (!picked || qty < 1 || !n) {
                    previewHead.textContent = 'Pick a model and enter a name to see the codes.';
                } else if (!valid && picked.next + qty - 1 > maxNumber) {
                    var left = Math.max(0, maxNumber - picked.next + 1);
                    previewHead.innerHTML = '<span class="text-danger">Only ' + left + ' code' + (left === 1 ? '' : 's')
                        + ' left for ' + escapeHtml(picked.prefix) + '. Register fewer, or give the category a new code.</span>';
                } else {
                    var first = picked.next;
                    var last = first + qty - 1;
                    previewHead.innerHTML = 'Will create <strong>' + qty + ' unit' + (qty === 1 ? '' : 's') + '</strong>'
                        + ' &middot; <span class="asset-code-chip">' + escapeHtml(codeFor(first)) + '</span>'
                        + (qty > 1 ? ' to <span class="asset-code-chip">' + escapeHtml(codeFor(last)) + '</span>' : '');

                    // First three, then "N more", then the last one.
                    var html = '';
                    var shown = Math.min(qty, 3);
                    for (var i = 0; i < shown; i++) html += row(i);
                    if (qty > 4) {
                        html += '<div class="bulk-preview-row bulk-preview-more"><span>&vellip;</span><span>'
                            + (qty - 4) + ' more unit' + (qty - 4 === 1 ? '' : 's') + '</span></div>';
                    }
                    if (qty > 3) html += row(qty - 1);
                    previewBody.innerHTML = html;
                }

                // Serial lines line up with the codes; blanks are fine.
                var lines = serials.value.split('\n');
                while (lines.length && !lines[lines.length - 1].trim()) lines.pop();
                var filled = lines.filter(function (l) { return l.trim().length > 0; }).length;
                if (!lines.length) {
                    serialCount.className = 'bulk-serial-count d-none';
                } else if (lines.length > qty) {
                    serialCount.textContent = lines.length + ' lines for ' + qty;
                    serialCount.className = 'bulk-serial-count is-error';
                } else {
                    serialCount.textContent = filled + ' of ' + qty + ' filled';
                    serialCount.className = 'bulk-serial-count';
                }

                // Gutter: one code per line, as many lines as units (or
                // typed lines, whichever is more, so extras stand out).
                var gutterLines = Math.max(qty, lines.length, 1);
                var g = '';
                for (var k = 0; k < gutterLines; k++) {
                    var label = picked && k < qty ? codeFor(picked.next + k) : (k < qty ? '#' + (k + 1) : 'extra');
                    g += '<div class="' + (k >= qty ? 'is-extra' : '') + '">' + escapeHtml(label) + '</div>';
                }
                gutter.innerHTML = g;
                serials.rows = Math.min(Math.max(qty, 3), 10);
                gutter.scrollTop = serials.scrollTop;

                // Summary tile: this batch and the other items (Scripts/037).
                // Bought for a requisition, the cost is each item's price on
                // the purchase order.
                var extras = Array.from(document.querySelectorAll('#extraRows [data-extra]'));
                var extraQty = extras.reduce(function (s, r) { return s + (parseInt(r.querySelector('[data-x=Quantity]').value, 10) || 0); }, 0);
                function linePrice(sel) { var o = sel && sel.options[sel.selectedIndex]; return o ? parseFloat(o.getAttribute('data-price')) : NaN; }
                var cost = unitCost ? parseFloat(unitCost.value) : linePrice(mainLine);
                var total = qty > 0 && cost > 0 ? cost * qty : 0;
                extras.forEach(function (r) {
                    var q = parseInt(r.querySelector('[data-x=Quantity]').value, 10) || 0;
                    var p = unitCost ? cost : linePrice(r.querySelector('[data-x=NewItemRequestItemID]'));
                    if (q > 0 && p > 0) total += q * p;
                });
                qty += extraQty;
                document.getElementById('sumUnits').textContent = qty > 0 ? qty : 0;
                sabShow(document.getElementById('sumCost'), total > 0 ? compactPeso(total) : '', 'Not set');
                document.getElementById('sumSerials').textContent = filled;
                document.getElementById('sharedSub').textContent = qty > 0
                    ? 'Set once, applied to all ' + qty + '.'
                    : 'Set once, applied to all of them.';
                document.getElementById('barcodeTitle').textContent = qty > 0
                    ? 'Barcode labels for all ' + qty
                    : 'Barcode labels for every unit';

                submitBtn.textContent = qty > 0
                    ? 'Register ' + qty + ' asset' + (qty === 1 ? '' : 's') + (extras.length ? ' (' + (extras.length + 1) + ' items)' : '')
                    : 'Register assets';
            }

            document.addEventListener('model-picked', function (e) {
                picked = e.detail;
                // Start the name off as the model's name if nothing is typed.
                if (picked && (!baseName.value.trim() || baseName.value === autoName)) {
                    baseName.value = picked.name;
                    autoName = picked.name;
                }
                update();
            });

            [quantity, baseName, serials, unitCost].forEach(function (el) {
                if (el) el.addEventListener('input', update);
            });

            // ---- Other items (Scripts/037) ----
            var mainLine = document.getElementById('mainLine');
            if (mainLine) mainLine.addEventListener('change', update);
            var extraRows = document.getElementById('extraRows');
            var qaModal = document.getElementById('quickAddModel');
            var mainPrefill = qaModal ? (qaModal.dataset.prefillName || '') : '';
            function wire(row) {
                var model = row.querySelector('[data-x=ModelID]'), name = row.querySelector('[data-x=BaseName]');
                var lineSel = row.querySelector('[data-x=NewItemRequestItemID]');
                var auto = name.dataset.auto ? name.value : '';
                model.addEventListener('change', function () {
                    var o = model.options[model.selectedIndex];
                    var n = o && o.value ? o.getAttribute('data-name') : '';
                    if (n && (!name.value.trim() || name.value === auto)) { name.value = n; auto = n; }
                    update();
                });
                row.addEventListener('input', update);
                if (lineSel) lineSel.addEventListener('change', update);
                row.querySelector('[data-x-remove]').addEventListener('click', function () { row.remove(); update(); });
                var nm = row.querySelector('[data-x-newmodel]');
                if (nm && qaModal) nm.addEventListener('click', function () {
                    // The new model is picked in this row, not the first one.
                    window.__qaTarget = row;
                    var o = lineSel && lineSel.options[lineSel.selectedIndex];
                    qaModal.dataset.prefillName = (o && o.getAttribute('data-name')) || '';
                    bootstrap.Modal.getOrCreateInstance(qaModal).show();
                });
            }
            Array.from(extraRows.querySelectorAll('[data-extra]')).forEach(wire);
            document.getElementById('addExtra').addEventListener('click', function () {
                var row = document.getElementById('extraTemplate').content.firstElementChild.cloneNode(true);
                // A requisition: start with the next item not on the form yet.
                var lineSel = row.querySelector('[data-x=NewItemRequestItemID]');
                if (lineSel) {
                    var used = [mainLine ? mainLine.value : ''].concat(Array.from(extraRows.querySelectorAll('[data-x=NewItemRequestItemID]')).map(function (s) { return s.value; }));
                    var free = Array.from(lineSel.options).find(function (o) { return used.indexOf(o.value) === -1; });
                    if (free) lineSel.value = free.value;
                }
                extraRows.appendChild(row);
                wire(row);
                row.querySelector('[data-x=ModelID]').focus();
                update();
            });
            // The first row's "+ Add a new model": back to its own name.
            var mainAdd = document.querySelector('.model-picker-add');
            if (mainAdd && qaModal) mainAdd.addEventListener('click', function () { window.__qaTarget = null; qaModal.dataset.prefillName = mainPrefill; });
            // A model added from a row's "+ New model": on every row's list, picked in that row.
            document.addEventListener('model-added', function (e) {
                var m = e.detail;
                Array.from(document.querySelectorAll('[data-x=ModelID]')).concat(Array.from(document.getElementById('extraTemplate').content.querySelectorAll('[data-x=ModelID]'))).forEach(function (sel) {
                    var o = document.createElement('option');
                    o.value = m.modelId; o.text = m.modelName + ' \u2014 ' + m.categoryName;
                    o.setAttribute('data-name', m.modelName); o.setAttribute('data-prefix', m.prefix);
                    sel.appendChild(o);
                });
                if (m.target && m.target.isConnected) {
                    var sel = m.target.querySelector('[data-x=ModelID]');
                    sel.value = String(m.modelId);
                    sel.dispatchEvent(new Event('change'));
                }
            });
            // Field names are numbered when the form is sent.
            document.getElementById('bulkForm').addEventListener('submit', function () {
                Array.from(extraRows.querySelectorAll('[data-extra]')).forEach(function (row, i) {
                    row.querySelectorAll('[data-x]').forEach(function (f) { f.name = 'Extras[' + i + '].' + f.getAttribute('data-x'); });
                });
            });
            serials.addEventListener('scroll', function () { gutter.scrollTop = serials.scrollTop; });
            createBarcode.addEventListener('change', update);

            // − / + beside the quantity.
            document.querySelectorAll('.qty-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var qty = (parseInt(quantity.value, 10) || 0) + parseInt(btn.getAttribute('data-step'), 10);
                    quantity.value = Math.min(200, Math.max(1, qty));
                    update();
                });
            });

            // The room shown under "Belongs to" follows the department.
            if (departmentSelect) departmentSelect.addEventListener('change', function () { showRoom(); update(); });
            showRoom();
            update();
        })();
    </script>
}
